{
  "name": "resourcepack-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Rule-based Minecraft Java Edition resource pack converter for Desktop and Web",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rpc/web dev",
    "dev:web": "pnpm --filter @rpc/web dev",
    "dev:desktop": "pnpm --filter @rpc/desktop dev",
    "build": "pnpm --filter @rpc/web build && pnpm --filter @rpc/desktop build",
    "build:web": "pnpm --filter @rpc/web build",
    "build:desktop": "pnpm --filter @rpc/desktop build",
    "package:desktop": "pnpm --filter @rpc/desktop package",
    "dist:desktop": "pnpm --filter @rpc/desktop dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "pnpm build:web && playwright test",
    "test:e2e:web": "pnpm build:web && playwright test",
    "test:e2e:desktop": "pnpm build:desktop && playwright test --config playwright.desktop.config.ts",
    "icons": "node tools/generate-icons.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

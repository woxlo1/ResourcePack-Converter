{
  "name": "@rpc/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ResourcePack Converter desktop application",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@rpc/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.woxlo.resourcepackconverter",
    "productName": "ResourcePack Converter",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}

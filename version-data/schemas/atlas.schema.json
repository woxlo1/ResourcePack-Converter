{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resourcepack-converter.local/schemas/atlas.schema.json",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["directory", "single", "filter", "paletted_permutations", "unstitch"]
          },
          "source": { "type": "string" },
          "prefix": { "type": "string" },
          "resource": { "type": "string" },
          "sprite": { "type": "string" },
          "sprites": { "type": "array", "items": { "type": "string" } },
          "textures": { "type": "array", "items": { "type": "string" } },
          "palette_key": { "type": "string" },
          "permutations": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

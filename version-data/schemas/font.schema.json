{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resourcepack-converter.local/schemas/font.schema.json",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "bitmap",
              "ttf",
              "space",
              "unihex",
              "reference",
              "legacy_unicode"
            ]
          },
          "file": { "type": "string" },
          "height": { "type": "number" },
          "ascent": { "type": "number" },
          "chars": { "type": "array", "items": { "type": "string" } },
          "shift": { "type": ["number", "array"] },
          "size_overrides": {},
          "advances": { "type": "object" },
          "id": { "type": "string" },
          "template": { "type": "string" },
          "sizes": { "type": "string" },
          "size": { "type": "number" },
          "oversample": { "type": "number" },
          "skip": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

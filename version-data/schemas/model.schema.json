{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resourcepack-converter.local/schemas/model.schema.json",
  "type": "object",
  "properties": {
    "parent": { "type": "string" },
    "ambientocclusion": { "type": "boolean" },
    "gui_light": { "type": "string", "enum": ["front", "side"] },
    "textures": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "sprite": { "type": "string" },
              "force_translucent": { "type": "boolean" }
            },
            "required": ["sprite"],
            "additionalProperties": true
          }
        ]
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "translation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
        },
        "additionalProperties": true
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "to": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "rotation": {
            "type": "object",
            "properties": {
              "origin": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "axis": { "type": "string", "enum": ["x", "y", "z"] },
              "angle": { "type": "number" },
              "rescale": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "shade": { "type": "boolean" },
          "shade_direction_override": { "type": "string" },
          "light_emission": { "type": "integer", "minimum": 0, "maximum": 15 },
          "faces": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "uv": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                "texture": { "type": "string" },
                "cullface": { "type": "string" },
                "rotation": { "type": "integer" },
                "tintindex": { "type": "integer" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model"],
        "properties": {
          "predicate": { "type": "object", "additionalProperties": { "type": ["number", "boolean", "string"] } },
          "model": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

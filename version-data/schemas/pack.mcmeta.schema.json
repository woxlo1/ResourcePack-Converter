{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resourcepack-converter.local/schemas/pack.mcmeta.json",
  "type": "object",
  "required": ["pack"],
  "properties": {
    "pack": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {
          "type": ["string", "object", "array"]
        },
        "pack_format": {
          "type": "integer",
          "minimum": 0
        },
        "min_format": {
          "$ref": "#/definitions/packFormat"
        },
        "max_format": {
          "$ref": "#/definitions/packFormat"
        },
        "supported_formats": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2 },
            {
              "type": "object",
              "properties": {
                "min_inclusive": { "type": "integer", "minimum": 0 },
                "max_inclusive": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "properties": {
        "enabled": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "filter": {
      "type": "object",
      "properties": {
        "block": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespace": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "overlays": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["directory"],
            "properties": {
              "directory": { "type": "string" },
              "formats": {},
              "min_format": { "$ref": "#/definitions/packFormat" },
              "max_format": { "$ref": "#/definitions/packFormat" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "region": { "type": "string" },
          "bidirectional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "packFormat": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2 }
      ]
    }
  }
}

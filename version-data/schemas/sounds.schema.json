{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resourcepack-converter.local/schemas/sounds.schema.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "enum": ["master", "music", "record", "weather", "block", "hostile", "neutral", "player", "ambient", "voice", "ui"]
      },
      "subtitle": { "type": "string" },
      "sounds": {
        "type": "array",
        "items": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "volume": { "type": "number", "minimum": 0 },
                "pitch": { "type": "number", "minimum": 0 },
                "weight": { "type": "integer", "minimum": 1 },
                "stream": { "type": "boolean" },
                "attenuation_distance": { "type": "number", "minimum": 1 },
                "preload": { "type": "boolean" },
                "type": { "type": "string", "enum": ["file", "event"] }
              },
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "additionalProperties": true
  }
}

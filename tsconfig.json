{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.desktop.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/dist-electron", "**/release"]
}
